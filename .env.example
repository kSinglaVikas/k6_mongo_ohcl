# Copy this file to .env and fill values.
# Wrapper service
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ohcl_data?retryWrites=true
DB_NAME=ohcl_data
ONED_EQ_COLLECTION=oned-eq
HISTORIC_EQ_COLLECTION=historic-eq
PORT=9000
DEBUG=false

# Benchmark defaults
API_BASE_URL=http://localhost:9000
TOTAL_RPS=100
MINUTES=2
RATE_STEP=1
RATE_STEP_SECONDS=5
PREALLOCATED_VUS=50
MAX_VUS=500
AGG_MIN_TS=2026-05-07T00:00:00Z
AGG_MAX_TS=2026-06-02T00:00:00Z
